{
  "//": "appsettings.Development.json にコピーして値を入れる。appsettings.Development.json はリポジトリに入れない（.gitignore 済み）。",
  "ReferralSearch": {
    "AiEnabled": true
  },
  "AzureOpenAI": {
    "Endpoint": "https://<リソース名>.openai.azure.com",
    "ApiKey": "<APIキー>",
    "Deployment": "<デプロイ名>",
