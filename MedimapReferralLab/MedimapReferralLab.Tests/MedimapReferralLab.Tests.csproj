<Project Sdk="Microsoft.NET.Sdk">

  <!--
    架空の症例を流す回帰テスト。
    xUnit などのテストフレームワーク（NuGet）に依存させず、コンソールアプリとして動かす。
    引数なしでオフラインの検査、引数 live で架空の症例を Azure OpenAI に流して測る（README.md）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\MedimapReferralLab.Core\MedimapReferralLab.Core.csproj" />
  </ItemGroup>

</Project>
